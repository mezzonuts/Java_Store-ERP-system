<?xml version="1.0" encoding="UTF-8"?>
<SplitPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.sosha.ui.pos.PosController" orientation="HORIZONTAL" dividerPositions="0.6">
    <VBox spacing="8" padding="20">
        <Label text="Scan Barcode" style="-fx-font-size:16;"/>
        <TextField fx:id="barcodeField" promptText="Barcode or SKU"/>
        <Label text="Cart"/>
        <TableView fx:id="cartTable" prefHeight="300">
            <columns>
                <TableColumn text="Product ID" prefWidth="200"/>
                <TableColumn text="Qty" prefWidth="80"/>
                <TableColumn text="Price" prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>
    <VBox spacing="12" padding="20">
        <Label fx:id="totalLabel" text="Rp 0" style="-fx-font-size:18; -fx-font-weight:bold;"/>
        <TextField fx:id="cashField" promptText="Cash received"/>
        <Button fx:id="payButton" text="F9 - Pay" prefWidth="200" style="-fx-font-size:16;"/>
        <Label fx:id="statusLabel"/>
    </VBox>
</SplitPane>
